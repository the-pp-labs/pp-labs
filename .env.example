# ==============================================================================
# PP LABS // AGENCY WORKSTATION CONFIGURATION
# ==============================================================================

# ADMIN DASHBOARD PASSCODE
# Change this to any secret password for accessing /admin
ADMIN_PASSCODE=pplabs2026

# NOTIFICATION RECIPIENT
# The email address that will receive incoming client lead alerts
NOTIFICATION_EMAIL=hello@pplabs.agency

# SENDER ADDRESS (Optional - must match your verified sending domain in production)
EMAIL_FROM=PP Labs Workstation <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# OPTION A: RESEND (Recommended for Vercel / Next.js)
# Get a free API key at https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# OPTION B: SMTP / NODEMAILER (Gmail, Outlook, Amazon SES, Brevo, custom SMTP)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_SECURE=false

# ------------------------------------------------------------------------------
# CLIENT ACKNOWLEDGMENT EMAIL
# Set to true to automatically send an instant acknowledgment receipt to client
# ------------------------------------------------------------------------------
SEND_LEAD_CONFIRMATION=true
